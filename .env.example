APP_ENV=development

# SQLite file by default. Any SQLAlchemy async URL works (e.g. postgresql+asyncpg://...).
DATABASE_URL=sqlite+aiosqlite:///./travel.db

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Groq (https://console.groq.com/keys). The model must support tool calling.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
