APP_ENV=development

# SQLite file by default. Any SQLAlchemy async URL works (e.g. postgresql+asyncpg://...).
DATABASE_URL=sqlite+aiosqlite:///./travel.db

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Which model service to use: "groq" or "openai_compatible".
LLM_PROVIDER=groq

# Used when LLM_PROVIDER=groq (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used in order while GROQ_MODEL is rate limited or out of its daily allowance. Empty = off.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# The orchestrator plans messages that need several specialists. Any OpenAI-style endpoint;
# if it fails or takes longer than the timeout, the main model plans instead.
#   Local Ollama (default):  http://localhost:11434/v1, key "ollama", model llama3.2:3b
#   OpenAI (paid):           https://api.openai.com/v1, your key, a model of your choice
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_BASE_URL=http://localhost:11434/v1
ORCHESTRATOR_API_KEY=ollama
ORCHESTRATOR_MODEL=llama3.2:3b
ORCHESTRATOR_TIMEOUT_SECONDS=180

# Used when LLM_PROVIDER=openai_compatible. Any OpenAI-style endpoint works; the model
# must support tool calling.
#   Cerebras    https://api.cerebras.ai/v1      key from https://cloud.cerebras.ai
#   OpenRouter  https://openrouter.ai/api/v1    key from https://openrouter.ai/keys
#   Ollama      http://localhost:11434/v1       any non-empty key
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=

# OpenStreetMap services. The public servers below are fine for one person testing;
# their usage policies forbid app-scale traffic, so a public launch points these at
# hosted or self-hosted servers. No code changes are needed.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION=© OpenStreetMap contributors

# Sign in with Google / GitHub (optional, free). A button appears for each provider
# whose ID and secret are both set. Callback addresses to register with the provider:
#   Google: http://localhost:8000/auth/google/callback
#   GitHub: http://localhost:8000/auth/github/callback
# Google: https://console.cloud.google.com -> APIs & Services -> OAuth consent screen,
#         then Credentials -> Create credentials -> OAuth client ID -> Web application.
# GitHub: https://github.com/settings/developers -> OAuth Apps -> New OAuth App.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The address people reach the app at. Leave empty for localhost; set it (https://...)
# once the app runs on a domain, and register that domain's callback addresses.
PUBLIC_BASE_URL=
